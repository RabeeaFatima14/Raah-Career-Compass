# Normalize line endings to LF in the repo, CRLF on Windows checkout
* text=auto

# Force LF for these file types
*.py text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.bat text eol=crlf
