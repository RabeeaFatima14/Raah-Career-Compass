# ============================================
# Raah Career Compass - Environment Variables
# ============================================
# Copy this file as .env and fill in your keys
# NEVER commit the .env file to git!

# Google Gemini AI (Required)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search (Optional - for web trends)
GOOGLE_SEARCH_API_KEY=your_google_search_key_here
GOOGLE_SEARCH_CX=your_search_engine_id_here

# Reddit API (Optional - for student insights)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_secret_here
