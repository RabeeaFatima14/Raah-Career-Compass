# =============================================
# Raah Career Compass — .gitignore
# =============================================

# ── Secrets (NEVER commit these) ─────────────
.env
serviceAccountKey.json
*.pem
*.key
*.p12

# ── Python ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# ── Node / Frontend ───────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────
*.log
logs/

# ── Portable Node.js (local dev only) ────────
nodejs/
nodejs.zip
